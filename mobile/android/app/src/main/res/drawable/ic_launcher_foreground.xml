        android:fillColor="#C2481A" />

    <!-- 右插口 -->
    <path
        android:pathData="M72,54m-14,0a14,14 0 1,0 28,0a14,14 0 1,0 -28,0"
        android:strokeColor="#C2481A"
        android:strokeWidth="5"
        android:fillColor="#00000000" />
    <path
        android:pathData="M72,54m-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0"
        android:fillColor="#C2481A" />
</vector>
