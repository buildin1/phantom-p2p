<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        VPN 应用的前台服务类型是 systemExempted，不是 specialUse。
        官方把 VPN 列为该类型的合法豁免场景；specialUse 还要在 Play Console
        单独说明理由，旧版本用错过一次。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!--
        WakeLock 与电池优化白名单是成对使用的：声明了就必须真的去获取，
        否则息屏后进程仍会被冻结。见 PhantomVpnService.acquireWakeLock()。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        扫码。相机只在扫码页用，运行时申请，拒绝了不影响其他功能。
        required=false：没有摄像头的设备照样能装，只是扫不了码。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        应用内更新。此应用不上架 Google Play（国内用不了），
        所以不受 Play 的自更新政策限制。
        Android 8+ 用户还要在系统里单独授权「允许安装未知应用」，
        第一次会跳系统设置页，这一步绕不过去。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".PhantomApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Phantom">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Phantom">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                phantom://room/7K2M9Q —— 房间码分享链接
                phantom://j/<20位令牌> —— 二维码里的邀请链接

                用自定义 scheme 而不是 https：走 https 要自建 web 落地页、
                配 App Links 校验文件（assetlinks.json），还会把信令域名印在
                每一张二维码上。代价是没装本应用的人扫了没反应——这是自定义
                scheme 的固有取舍。系统相机扫到时通常会提示「用 Phantom 打开」。
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="phantom" android:host="room" />
                <data android:scheme="phantom" android:host="j" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.PhantomVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!--
                声明后用户可在「设置 → 网络 → VPN」把本应用设为 always-on。
                这是后台存活最可靠的手段：进程被杀时系统会自动重启服务。
            -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <receiver
            android:name=".vpn.TunnelActionReceiver"
            android:exported="false" />

        <!--
            应用内更新的安装结果回调。exported=false：只有系统的
            PackageInstaller 会通过我们自己给出的 PendingIntent 触发它。
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

    </application>
</manifest>
