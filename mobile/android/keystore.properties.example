# 复制成 keystore.properties 后填写。该文件已在 .gitignore 里，绝不入库。
#
# 生成一个新 keystore：
#   keytool -genkey -v -keystore phantom-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias phantom
#
# 警告：这个 keystore 丢了就再也无法给已发布的应用推更新——Play 商店
# 与直接侧载都靠签名认身份，换 key 等于换了一个应用。备份好。

storeFile=phantom-release.jks
storePassword=
keyAlias=phantom
keyPassword=
