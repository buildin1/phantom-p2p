<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Phantom.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="rippleColor">@color/primarySoft</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Phantom.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/primarySoft</item>
        <item name="android:textColor">@color/textMain</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Phantom.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/primarySoft</item>
        <item name="android:textColor">@color/textMuted</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>
    
</resources>