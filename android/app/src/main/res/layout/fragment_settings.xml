<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="104dp">

        <!-- ── Hero Panel ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_hero_panel">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统设置"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="偏好配置"
                android:textColor="@color/textMain"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="信令服务器与联机策略"
                android:textColor="@color/textMuted"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code_box"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="服务器配置"
                    android:textColor="@color/textMain"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_code_box"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="连接策略"
                    android:textColor="@color/textMain"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ 开发者选项（standard 版本隐藏）：服务器地址、联机配置、连接策略 ══ -->
        <LinearLayout
            android:id="@+id/devSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Section: 服务器 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="信令服务器"
            android:textColor="@color/sectionTitle"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_panel">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="服务器地址"
                android:textColor="@color/textMuted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etSignalUrl"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:inputType="textUri"
                android:textColor="@color/textMain"
                android:textSize="13sp"
                android:background="@drawable/bg_code_box"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:fontFamily="monospace"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Section: 联机配置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="联机配置"
            android:textColor="@color/sectionTitle"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel">

            <!-- Game Port row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="14dp" android:paddingEnd="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="游戏端口" android:textColor="@color/textMain" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="主机游戏监听端口" android:textColor="@color/textMuted" android:textSize="11sp" />
                </LinearLayout>
                <EditText android:id="@+id/etGamePort"
                    android:layout_width="90dp" android:layout_height="40dp"
                    android:inputType="number" android:gravity="center"
                    android:textColor="@color/textMain" android:textSize="14sp"
                    android:background="@drawable/bg_code_box" android:fontFamily="monospace" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/hairline" android:layout_marginStart="14dp" />

            <!-- Guest Port row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="14dp" android:paddingEnd="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="客机端口" android:textColor="@color/textMain" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Guest 本地监听端口" android:textColor="@color/textMuted" android:textSize="11sp" />
                </LinearLayout>
                <EditText android:id="@+id/etGuestPort"
                    android:layout_width="90dp" android:layout_height="40dp"
                    android:inputType="number" android:gravity="center"
                    android:textColor="@color/textMain" android:textSize="14sp"
                    android:background="@drawable/bg_code_box" android:fontFamily="monospace" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/hairline" android:layout_marginStart="14dp" />

            <!-- Protocol row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="14dp" android:paddingEnd="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="默认协议" android:textColor="@color/textMain" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="房间传输协议" android:textColor="@color/textMuted" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segmented_track" android:padding="2dp">
                    <TextView android:id="@+id/btnProtoTcp"
                        android:layout_width="56dp" android:layout_height="match_parent"
                        android:gravity="center" android:text="TCP"
                        android:textColor="@color/segmentText" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnProtoUdp"
                        android:layout_width="56dp" android:layout_height="match_parent"
                        android:gravity="center" android:text="UDP"
                        android:textColor="@color/segmentTextActive" android:textSize="13sp" android:textStyle="bold"
                        android:background="@drawable/bg_segment_active" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Section: 连接策略 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="连接策略"
            android:textColor="@color/sectionTitle"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel">

            <!-- Auto Connect -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="14dp" android:paddingEnd="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="自动连接" android:textColor="@color/textMain" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="启动时自动连接信令服务器" android:textColor="@color/textMuted" android:textSize="11sp" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoConnect" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/hairline" android:layout_marginStart="14dp" />

            <!-- Auto Relay -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="14dp" android:paddingEnd="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="自动中继" android:textColor="@color/textMain" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="自动协商中继线路" android:textColor="@color/textMuted" android:textSize="11sp" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoRelay" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/hairline" android:layout_marginStart="14dp" />

            <!-- Relay Fallback -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="14dp" android:paddingEnd="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="中继回退" android:textColor="@color/textMain" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="P2P 失败时自动切换中继" android:textColor="@color/textMuted" android:textSize="11sp" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchRelayFallback" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/hairline" android:layout_marginStart="14dp" />

            <!-- Force Relay -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="14dp" android:paddingEnd="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="强制中继" android:textColor="@color/textMain" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="始终使用中继（测试用）" android:textColor="@color/textMuted" android:textSize="11sp" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchForceRelay" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/hairline" android:layout_marginStart="14dp" />

            <!-- Prefer IPv6 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="14dp" android:paddingEnd="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="优先 IPv6" android:textColor="@color/textMain" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="优先使用 IPv6 网络" android:textColor="@color/textMuted" android:textSize="11sp" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPreferIpv6" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>
        <!-- /开发者选项 -->

        <!-- Section: Android runtime -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_android_runtime"
            android:textColor="@color/sectionTitle"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_vpn_permission"
                        android:textColor="@color/textMain"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/label_vpn_permission_sub"
                        android:textColor="@color/textMuted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvVpnPermissionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/status_not_granted"
                        android:textColor="@color/textMuted"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantVpnPermission"
                    style="@style/Widget.Phantom.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/btn_grant_vpn"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline"
                android:layout_marginStart="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_background_keepalive"
                        android:textColor="@color/textMain"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/label_background_keepalive_sub"
                        android:textColor="@color/textMuted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvBackgroundPermissionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/status_not_whitelisted"
                        android:textColor="@color/textMuted"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantBackgroundPermission"
                    style="@style/Widget.Phantom.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/btn_grant_background"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline"
                android:layout_marginStart="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_vpn_runtime"
                        android:textColor="@color/textMain"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/label_vpn_runtime_sub"
                        android:textColor="@color/textMuted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvVpnRuntimeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/status_stopped"
                        android:textColor="@color/textMuted"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartVpnService"
                        style="@style/Widget.Phantom.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/btn_start_vpn"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStopVpnService"
                        style="@style/Widget.Phantom.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/btn_stop_vpn"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Save / Reset buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="保存设置"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetSettings"
                style="@style/Widget.Phantom.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="恢复默认"
                android:textColor="@color/textMuted"
                android:textSize="14sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="16dp" />
    </LinearLayout>
</ScrollView>
