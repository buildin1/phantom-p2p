<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="104dp">

        <!-- ── Hero Panel ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:minHeight="120dp"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hero_panel">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="幻梦 P2P 联机"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="房间管理"
                    android:textColor="@color/textMain"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
                <TextView
                    android:id="@+id/tvHeroSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="通过 P2P 直连游戏"
                    android:textColor="@color/textMuted"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_code_box"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="独立 Host / Guest"
                        android:textColor="@color/textMain"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_code_box"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="多端口映射"
                        android:textColor="@color/textMain"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Status Pill -->
            <LinearLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_status_pill_offline">
                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_offline" />
                <TextView
                    android:id="@+id/tvStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="离线"
                    android:textColor="@color/pillOfflineText"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 我的房间 (Host) ── -->
        <!-- Always-visible Host address and fixed-IP control. -->
        <LinearLayout
            android:id="@+id/topHostIpCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/bg_panel">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本机公网 IP"
                    android:textColor="@color/textMuted"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvTopHostVirtualIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="127.0.0.1"
                    android:textColor="@color/textMain"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvTopHostIpMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未开房间"
                android:textColor="@color/textMuted"
                android:textSize="11sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTopRequestFixedIp"
                style="@style/Widget.Phantom.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="申请固定 IP"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSectionMyRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="我的房间"
            android:textColor="@color/sectionTitle"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cardMyRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_panel"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前房间"
                        android:textColor="@color/textMain"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="房间码生成后在这里统一管理和分发"
                        android:textColor="@color/textMuted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code_box"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="Host"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                android:layout_marginTop="14dp">
                <TextView
                    android:id="@+id/tvRoomCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="------"
                    android:textColor="@color/colorPrimary"
                    android:textSize="34sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_qr_placeholder">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="QR"
                        android:textColor="@color/textMuted"
                        android:textSize="11sp" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView
                    android:id="@+id/tvTransportBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="UDP"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_status_pill_ok" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyCode"
                    style="@style/Widget.Phantom.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="复制配对码"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseRoom"
                    style="@style/Widget.Phantom.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:text="关闭房间"
                    android:textColor="@color/colorDanger"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:background="@drawable/bg_code_box"
                android:id="@+id/inlineHostIpCard"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本机公网 IP"
                        android:textColor="@color/textMuted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvHostVirtualIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="127.0.0.1"
                        android:textColor="@color/textMain"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvHostIpMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未开房间"
                    android:textColor="@color/textMuted"
                    android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRequestFixedIp"
                    style="@style/Widget.Phantom.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="申请固定 IP"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 创建房间 ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOST 控制区"
            android:textColor="@color/sectionTitle"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="创建房间（Host）"
                        android:textColor="@color/textMain"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="设置端口和协议后生成配对码，等待玩家加入"
                        android:textColor="@color/textMuted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code_box"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="服务端视角"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Protocol row -->
            <LinearLayout
                android:id="@+id/rowProtocol"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="协议"
                    android:textColor="@color/textMuted"
                    android:textSize="14sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segmented_track"
                    android:padding="2dp">
                    <TextView
                        android:id="@+id/btnProtoTcp"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="TCP"
                        android:textColor="@color/segmentText"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/btnProtoUdp"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="UDP"
                        android:textColor="@color/segmentTextActive"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_segment_active" />
                </LinearLayout>
            </LinearLayout>

            <!-- Game port row -->
            <LinearLayout
                android:id="@+id/rowGamePort"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="游戏端口"
                        android:textColor="@color/textMain"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="主机监听的端口"
                        android:textColor="@color/textMuted"
                        android:textSize="11sp" />
                </LinearLayout>
                <EditText
                    android:id="@+id/etGamePort"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:text="25565"
                    android:inputType="number"
                    android:gravity="center"
                    android:textColor="@color/textMain"
                    android:textSize="15sp"
                    android:background="@drawable/bg_code_box" />
            </LinearLayout>

            <!-- Multi-port toggle row -->
            <LinearLayout
                android:id="@+id/rowMultiPort"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="多端口映射"
                        android:textColor="@color/textMain"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="同时开放多个端口（高级）"
                        android:textColor="@color/textMuted"
                        android:textSize="11sp" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMultiPort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Advanced port panel (multi-port) -->
            <LinearLayout
                android:id="@+id/advancedPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/bg_code_box"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:paddingTop="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="端口规格（支持范围 25565, 10010-10020）"
                    android:textColor="@color/textMuted"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/etPortSpec"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="25565, 10010-10020"
                        android:textColor="@color/textMain"
                        android:textColorHint="@color/textMuted"
                        android:textSize="13sp"
                        android:background="@drawable/bg_code_box"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnParsePort"
                        style="@style/Widget.Phantom.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:text="解析预览"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Port table wrapper -->
                <LinearLayout
                    android:id="@+id/portTableWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <!-- Table header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@color/surfaceSoft">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="端口号"
                            android:textColor="@color/textMuted"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="本地地址"
                            android:textColor="@color/textMuted"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Table body (rows injected dynamically) -->
                    <LinearLayout
                        android:id="@+id/portTableBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Pagination -->
                    <LinearLayout
                        android:id="@+id/portPagination"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPortPrev"
                            style="@style/Widget.Phantom.Button.Text"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="‹"
                            android:textSize="20sp" />
                        <TextView
                            android:id="@+id/tvPortPageInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="1 / 1"
                            android:textColor="@color/textMuted"
                            android:textSize="13sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPortNext"
                            style="@style/Widget.Phantom.Button.Text"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="›"
                            android:textSize="20sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Create button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateRoom"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="创建房间"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ── 加入房间 ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GUEST 接入区"
            android:textColor="@color/sectionTitle"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="加入房间（Guest）"
                        android:textColor="@color/textMain"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="输入 6 位配对码后开始连接，地址将映射到本机"
                        android:textColor="@color/textMuted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code_box"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="玩家视角"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="房间配对码"
                android:textColor="@color/textMuted"
                android:textSize="12sp" />

            <!-- 输入状态 -->
            <LinearLayout
                android:id="@+id/joinInputContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 6-box room code input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <EditText android:id="@+id/codeBox1"
                        android:layout_width="0dp" android:layout_height="52dp"
                        android:layout_weight="1"
                        android:gravity="center" android:inputType="textCapCharacters"
                        android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/textMain" android:background="@drawable/bg_code_box" />
                    <View android:layout_width="6dp" android:layout_height="0dp" />
                    <EditText android:id="@+id/codeBox2"
                        android:layout_width="0dp" android:layout_height="52dp"
                        android:layout_weight="1"
                        android:gravity="center" android:inputType="textCapCharacters"
                        android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/textMain" android:background="@drawable/bg_code_box" />
                    <View android:layout_width="6dp" android:layout_height="0dp" />
                    <EditText android:id="@+id/codeBox3"
                        android:layout_width="0dp" android:layout_height="52dp"
                        android:layout_weight="1"
                        android:gravity="center" android:inputType="textCapCharacters"
                        android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/textMain" android:background="@drawable/bg_code_box" />
                    <View android:layout_width="6dp" android:layout_height="0dp" />
                    <EditText android:id="@+id/codeBox4"
                        android:layout_width="0dp" android:layout_height="52dp"
                        android:layout_weight="1"
                        android:gravity="center" android:inputType="textCapCharacters"
                        android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/textMain" android:background="@drawable/bg_code_box" />
                    <View android:layout_width="6dp" android:layout_height="0dp" />
                    <EditText android:id="@+id/codeBox5"
                        android:layout_width="0dp" android:layout_height="52dp"
                        android:layout_weight="1"
                        android:gravity="center" android:inputType="textCapCharacters"
                        android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/textMain" android:background="@drawable/bg_code_box" />
                    <View android:layout_width="6dp" android:layout_height="0dp" />
                    <EditText android:id="@+id/codeBox6"
                        android:layout_width="0dp" android:layout_height="52dp"
                        android:layout_weight="1"
                        android:gravity="center" android:inputType="textCapCharacters"
                        android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/textMain" android:background="@drawable/bg_code_box" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJoinRoom"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="连接"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 连接中状态（crossfade 替换输入区，风格对齐 cardMyRoom） -->
            <LinearLayout
                android:id="@+id/joiningStateContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="正在建立连接"
                            android:textColor="@color/textMain"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="ICE 协商 / 中继分配中，请稍候…"
                            android:textColor="@color/textMuted"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_code_box"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="连接中"
                        android:textColor="@color/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvJoiningCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="------"
                    android:textColor="@color/colorPrimary"
                    android:textSize="34sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:trackCornerRadius="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Guest Port Forward Panel (advanced mode) ── -->
        <LinearLayout
            android:id="@+id/guestPortPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:background="@drawable/bg_panel"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="端口转发状态"
                android:textColor="@color/sectionTitle"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/guestPortList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Bottom spacer -->
        <View android:layout_width="match_parent" android:layout_height="16dp" />

    </LinearLayout>
</ScrollView>
